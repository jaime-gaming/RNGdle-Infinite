+/* CLEANUP Nov 4, 2026: seasonal scenery/shop only. Keep Hexbound aura art. */
+.rngween-world {
+  --world-accent: #5eead4;
+  --world-text: #eae3f5;
+  --world-muted: #aaa0be;
+  color: var(--world-text);
+  display: block;
+  width: min(1040px, 100%);
+  margin: 0 auto;
+  padding: 28px 24px 38px;
+  min-height: 100vh;
+  isolation: isolate;
+  color-scheme: dark;
+}
+.rngween-world button {
+  font-family: inherit;
+}
+.rngween-world button:focus-visible {
+  outline: 2px solid #dfb787;
+  outline-offset: 4px;
+}
+.rngween-world button:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+.world-header {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  flex-wrap: wrap;
+}
+.world-back,
+.world-wallet {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  background: #1d172b;
+  color: var(--world-text);
+  border: 1px solid #463853;
+  border-radius: 10px;
+  padding: 11px 14px;
+  cursor: pointer;
+  font-size: 12px;
+}
+.world-back:hover,
+.world-wallet:hover {
+  border-color: #a17e99;
+}
+.world-event-date {
+  font-size: 10px;
+  letter-spacing: 0.07em;
+  color: #968598;
+  margin: 0 auto;
+}
+.world-wallet strong {
+  color: #f4b982;
+  font-variant-numeric: tabular-nums;
+}
+.world-wallet > span:last-child {
+  font-size: 10px;
+}
+.world-heading {
+  text-align: center;
+  padding: 45px 12px 30px;
+  color: #cdbedc;
+}
+.world-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: #b69bb8;
+}
+.world-heading h1 {
+  margin: 12px 0 10px;
+  font-size: clamp(30px, 5vw, 49px);
+  line-height: 1.14;
+  letter-spacing: -0.045em;
+  color: #947580;
+}
+.world-heading > p {
+  font-size: 12px;
+  color: #927f9c;
+}
+.world-zones {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+  margin-bottom: 20px;
+}
+.world-zone {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 7px;
+  padding: 19px 20px;
+  min-width: 0;
+  border: 1px solid #42334f;
+  background: linear-gradient(145deg, #20172e, #16121f);
+  border-radius: 14px;
+  color: #c3b5d2;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    border-color 0.2s,
+    transform 0.2s,
+    background 0.2s;
+  overflow: hidden;
+}
+.world-zone::after {
+  content: "";
+  position: absolute;
+  width: 80px;
+  height: 80px;
+  right: -40px;
+  bottom: -40px;
+  border-radius: 50%;
+  background: var(--zone-accent);
+  filter: blur(35px);
+  opacity: 0.08;
+  pointer-events: none;
+}
+.world-zone:hover:not(:disabled) {
+  background: linear-gradient(145deg, #20172e, #16121f);
+  color: #c3b5d2;
+  border-color: var(--zone-accent);
+  transform: translateY(-2px);
+}
+.world-zone.is-selected {
+  border-color: var(--zone-accent);
+  box-shadow:
+    inset 0 0 24px color-mix(in srgb, var(--zone-accent) 7%, transparent),
+    0 0 20px color-mix(in srgb, var(--zone-accent) 7%, transparent);
+}
+.world-zone-glyph {
+  color: var(--zone-accent);
+  margin-bottom: 9px;
+}
+.world-zone-number {
+  position: absolute;
+  top: 19px;
+  right: 20px;
