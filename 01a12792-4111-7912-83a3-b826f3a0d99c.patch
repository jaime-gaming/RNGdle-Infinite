@@ -0,0 +1,127 @@
+import React, { useEffect, useLayoutEffect, useState } from "react";
+import { useMotionPreference, useSettings } from "../use-settings.jsx";
+import { rngweenCalendar } from "../rngween.js";
+import {
+  BatMark,
+  BloodMoonMark,
+  PhantomMark,
+  PumpkinMark,
+} from "./game-icons.jsx";
+import RngweenSecrets from "./RngweenSecrets.jsx";
+import "../rngween.css";
+
+function Web({ className }) {
+  return (
+    <svg
+      className={className}
+      viewBox="0 0 100 100"
+      fill="none"
+      stroke="currentColor"
+    >
+      <path d="M0 0v100M0 0h100M0 0l71 71M0 0l38 92M0 0l92 38M0 24q10 0 9 9 10-5 13 4 0-12 15-7-4-12-13-6M0 50q22-4 19 19 19-11 23 8 1-21 24-17-12-19-16-10M0 78q29-4 30 30 28-16 36 6 4-29 36-20-20-24-24-16" />
+    </svg>
+  );
+}
+
+function Candle({ className }) {
+  return (
+    <span className={`rngween-candle ${className}`}>
+      <span className="rngween-flame" />
+      <span className="rngween-wax" />
+    </span>
+  );
+}
+
+// CLEANUP Nov 4, 2026: remove this mount, backdrop/secrets, seasonal palette and
+// favicon. Keep the four permanent owned-aura renderers and their effects.
+export default function RngweenSeason({
+  now,
+  theme,
+  interactive = false,
+  notify,
+}) {
+  const season = rngweenCalendar(now);
+  const { settings } = useSettings();
+  const reduced = useMotionPreference();
+  const enabled =
+    season.decorated && theme === "dark" && settings.halloweenMode;
+  const [headerHeight, setHeaderHeight] = useState(48);
+  useLayoutEffect(() => {
+    if (!enabled) return;
+    const header = document.querySelector(".header");
+    if (!header) return;
+    const align = () => setHeaderHeight(header.getBoundingClientRect().height);
+    align();
+    const observer = new ResizeObserver(align);
+    observer.observe(header);
+    return () => observer.disconnect();
+  }, [enabled]);
+  useEffect(() => {
+    const root = document.documentElement;
+    const favicon = document.querySelector('link[rel="icon"]');
+    const originalIcon = favicon?.getAttribute("href");
+    if (enabled) {
+      root.dataset.season = "rngween";
+      favicon?.setAttribute(
+        "href",
+        `${import.meta.env.BASE_URL}favicon-halloween.svg`,
+      );
+    } else delete root.dataset.season;
+    return () => {
+      delete root.dataset.season;
+      if (originalIcon) favicon?.setAttribute("href", originalIcon);
+    };
+  }, [enabled]);
+  if (!enabled) return null;
+  return (
+    <>
+      <div
+        className={`rngween-decor${reduced ? " is-reduced-motion" : ""}`}
+        aria-hidden="true"
+        style={{ top: headerHeight }}
+      >
+        <div className="rngween-mist" />
+        <Web className="rngween-web" />
+        <Web className="rngween-web rngween-web-right" />
+        <svg
+          className="rngween-spider"
+          viewBox="0 0 30 110"
+          fill="none"
+          stroke="currentColor"
+        >
+          <path d="M15 0v77M11 85 3 80M11 88 2 89M11 91 4 99M19 85l8-5M19 88l9 1M19 91l7 8" />
+          <ellipse cx="15" cy="88" rx="5" ry="7" fill="currentColor" />
+          <circle cx="13" cy="85" r="0.8" fill="var(--bg)" stroke="none" />
+          <circle cx="17" cy="85" r="0.8" fill="var(--bg)" stroke="none" />
+        </svg>
+        <PumpkinMark className="rngween-pumpkin" size={44} />
+        <PumpkinMark
+          className="rngween-pumpkin rngween-pumpkin-small"
+          size={27}
+        />
+        <PumpkinMark
+          className="rngween-pumpkin rngween-pumpkin-low"
+          size={37}
+        />
+        <BloodMoonMark className="rngween-moon" size={58} />
+        <BatMark className="rngween-bat" size={44} />
+        <BatMark className="rngween-bat rngween-bat-second" size={28} />
+        <BatMark className="rngween-bat rngween-bat-third" size={22} />
+        <PhantomMark className="rngween-ghost" size={40} />
+        <PhantomMark className="rngween-ghost rngween-ghost-low" size={31} />
+        <Candle className="rngween-candle-left" />
+        <Candle className="rngween-candle-right" />
+        <span className="rngween-candy rngween-candy-left" />
+        <span className="rngween-candy rngween-candy-right" />
+        {[0, 1, 2, 3, 4, 5].map((i) => (
+          <span key={i} className={`rngween-spark rngween-spark-${i}`} />
+        ))}
+      </div>
+      <RngweenSecrets
+        reduced={reduced}
+        interactive={interactive}
+        notify={notify}
+      />
+    </>
+  );
+}
diff --git a/src/components/RngweenSecrets.jsx b/src/components/RngweenSecrets.jsx
new file mode 100644
index 0000000..6f4373c
--- /dev/null
+++ b/src/components/RngweenSecrets.jsx
@@ -0,0 +1,131 @@
+import React, { useCallback, useEffect, useRef, useState } from "react";
+import {
+  BatMark,
+  BloodMoonMark,
+  PhantomMark,
+  PumpkinMark,
+} from "./game-icons.jsx";
+
+// Temporary, purely decorative secrets. No progress writer or gameplay RNG.
+// CLEANUP Nov 4, 2026: remove with the seasonal backdrop, not owned aura art.
+export default function RngweenSecrets({ reduced, interactive, notify }) {
+  const [reveal, setReveal] = useState(null);
+  const [lantern, setLantern] = useState(false);
+  const moonTaps = useRef(0);
+  const sequence = useRef(0);
+  const timer = useRef(null);
+
+  const uncover = useCallback(
+    (kind) => {
+      clearTimeout(timer.current);
+      sequence.current += 1;
+      setReveal({ kind, key: sequence.current });
+      notify?.({
+        kind: "info",
+        title:
+          kind === "spirits"
+            ? "Boo!"
+            : kind === "bats"
+              ? "Bats!"
+              : "Pumpkin lantern",
+        text:
+          kind === "spirits"
+            ? "You found the hidden ghosts."
+            : kind === "bats"
+              ? "Three taps woke the bats."
+              : "Lantern toggled.",
+      });
+      timer.current = setTimeout(() => setReveal(null), 4800);
+    },
+    [notify],
+  );
+
+  useEffect(() => {
+    let letters = "";
+    const type = (event) => {
+      if (event.ctrlKey || event.altKey || event.metaKey || event.isComposing)
+        return;
+      if (
+        event.target?.closest?.(
+          'input, textarea, select, [contenteditable], [role="dialog"], [role="menu"]',
+        )
+      ) {
+        letters = "";
+        return;
+      }
+      if (event.key.length !== 1) {
+        letters = "";
+        return;
+      }
+      letters = (letters + event.key.toLowerCase()).slice(-3);
+      if (letters === "boo") {
+        uncover("spirits");
+        letters = "";
+      }
+    };
+    window.addEventListener("keydown", type);
+    return () => {
+      window.removeEventListener("keydown", type);
+      clearTimeout(timer.current);
+    };
+  }, [uncover]);
+
+  return (
+    <>
+      {interactive && (
+        <div className={`rngween-curios${reduced ? " is-reduced-motion" : ""}`}>
+          <button
+            type="button"
+            className="rngween-curio rngween-curio-lantern"
+            aria-label="Pumpkin lantern"
+            aria-pressed={lantern}
+            title="Pumpkin lantern"
+            onClick={() => {
+              setLantern((value) => !value);
+              uncover("lantern");
+            }}
+          >
+            <PumpkinMark size={29} />
+          </button>
+          <button
+            type="button"
+            className="rngween-curio rngween-curio-moon"
+            aria-label="Knock on the moon"
+            title="Tap three times"
+            onClick={() => {
+              moonTaps.current += 1;
+              if (moonTaps.current % 3 === 0) uncover("bats");
+            }}
+          >
+            <BloodMoonMark size={29} />
+          </button>
+        </div>
+      )}
+      {reveal && (
+        <div
+          key={reveal.key}
+          className={`rngween-secret-reveal${reduced ? " is-reduced-motion" : ""}`}
+          data-secret={reveal.kind}
+          aria-hidden="true"
+        >
+          {[0, 1, 2, 3, 4].map((i) => {
+            const Mark =
+              reveal.kind === "spirits"
+                ? PhantomMark
+                : reveal.kind === "bats"
+                  ? BatMark
+                  : PumpkinMark;
+            return (
+              <Mark
+                key={i}
+                className="rngween-secret-sprite"
+                size={32}
+                style={{ "--sprite": i }}
+              />
+            );
+          })}
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/src/components/RngweenShop.jsx b/src/components/RngweenShop.jsx
new file mode 100644
index 0000000..e962512
--- /dev/null
+++ b/src/components/RngweenShop.jsx
@@ -0,0 +1,608 @@
+import React, { useEffect, useRef, useState } from "react";
+import {
+  ArrowLeft,
+  ArrowRight,
+  ArrowRightLeft,
+  Check,
+  Clock,
+  Sparkles,
+} from "lucide-react";
+import { pathForSubpage } from "../router.js";
+import { RNGWEEN_WORLD_SKIN, rngweenCalendar } from "../rngween.js";
+import {
+  EP_PER_PUMPKOIN,
+  RNGWEEN_LIMITED_ITEMS,
+  RNGWEEN_PET,
+  RNGWEEN_SKILL,
+} from "../rngween-limited.js";
+import { rngweenValleyUnlocked, worldState } from "../rngween-world-zones.js";
+import { useFormatEP } from "../use-settings.jsx";
+import { waitText } from "../tasks.js";
+import NumberBox from "./NumberBox.jsx";
+import PetIcon from "./PetIcon.jsx";
+import {
+  PhantomMark,
+  PumpkinMark,
+  WitchfireMark,
+  SkillIcon,
+  WorldKeyMark,
+  HexboundMark,
+} from "./game-icons.jsx";
+import "../rngween-limited.css";
+
+const count = (n) => n.toLocaleString("en-US");
+export function Pumpkoin({ size = 20 }) {
+  return (
+    <span className="pumpkoin-mark" aria-hidden="true">
+      <PumpkinMark size={size} />
+    </span>
+  );
+}
+
+// One large, first shelf. Not a global event banner and not a rotating EP item.
+export function RngweenShopDoor({ progress, onOpen }) {
+  return (
+    <a
+      className="rngween-shop-door"
+      data-shelf="limited"
+      href={pathForSubpage("shop", "limited")}
+      onClick={(event) => {
+        if (
+          event.button ||
+          event.metaKey ||
+          event.ctrlKey ||
+          event.shiftKey ||
+          event.altKey
+        )
+          return;
+        event.preventDefault();
+        onOpen?.("limited");
+      }}
+    >
+      <span className="rngween-door-art" aria-hidden="true">
+        <PumpkinMark size={76} />
+        <PhantomMark size={30} />
+        <WitchfireMark size={28} />
+      </span>
+      <span className="rngween-door-copy">
+        <span className="rngween-limited-kicker">
+          One-time shelf · closes Nov 3, 23:59 UTC
+        </span>
+        <strong>Limited Shop: RNGween 2026</strong>
+        <span>
+          Pumpkin Familiar, Midnight Harvest and the Valley Challenge Key.
+        </span>
+        <small>
+          <Pumpkoin size={15} />{" "}
+          {count(progress.rngweenLimited?.pumpkoins ?? 0)} Pumpkoins · exchange
+          EP inside
+        </small>
+      </span>
+      <ArrowRight size={22} aria-hidden="true" />
+    </a>
+  );
+}
+
+export default function RngweenShop({
+  progress,
+  now,
+  onAction,
+  onBack,
+  onWorld,
+  onCollection,
+  openSignup,
+  notify,
+}) {
+  const calendar = rngweenCalendar(now);
+  const limited = progress.rngweenLimited;
+  const live = calendar.limitedPhase === "active" && !limited?.retired;
+  const formatEP = useFormatEP();
+  const [quantity, setQuantity] = useState("100");
+  const [confirmation, setConfirmation] = useState(null);
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState("");
+  const busy = useRef(false);
+  const dialog = useRef(null);
+  const restoreFocus = useRef(null);
+  const heading = useRef(null);
+  const wallet = limited?.pumpkoins ?? 0;
+  const max = Math.floor(progress.balance / EP_PER_PUMPKOIN);
+  const amount = Number(quantity);
+  const valid = Number.isSafeInteger(amount) && amount > 0 && amount <= max;
+  const unlocked = rngweenValleyUnlocked(limited);
+  const world = worldState(limited);
+  const readyToForge =
+    world.fragments.graveyard && world.fragments["haunted-house"];
+  const hexboundOwned = progress.owned.includes(RNGWEEN_WORLD_SKIN.id);
+  const items = RNGWEEN_LIMITED_ITEMS.filter(
+    (item) => item.kind !== "aura" || !progress.owned.includes(item.id),
+  );
+  useEffect(() => {
+    if (confirmation) {
+      restoreFocus.current = document.activeElement;
+      dialog.current?.showModal();
+      dialog.current?.querySelector("button")?.focus();
+    } else {
+      dialog.current?.close();
+      if (restoreFocus.current?.isConnected) restoreFocus.current.focus();
+      else if (restoreFocus.current) heading.current?.focus();
+    }
+  }, [confirmation]);
+  async function run(action) {
+    if (busy.current) return false;
+    busy.current = true;
+    setPending(true);
+    setError("");
+    try {
+      const outcome = await onAction(action);
+      if (!outcome?.ok) {
+        setError(outcome?.message ?? "Nothing was spent. Please retry.");
+        return false;
+      }
+      return true;
+    } finally {
+      busy.current = false;
+      setPending(false);
+    }
+  }
+  async function confirm() {
+    const choice = confirmation;
+    if (!choice || !live) return;
+    const ok = await run(choice.action);
+    if (ok) {
+      setConfirmation(null);
+      notify?.({
+        kind: "done",
+        title: choice.item
+          ? `${choice.item.name} collected`
+          : "Pumpkoins exchanged",
+        text:
+          choice.item?.kind === "world-key"
+            ? "Valley challenge unlocked. Your key is never consumed."
+            : choice.item?.kind === "aura"
+              ? "Your Halloween aura stays yours forever."
+              : choice.item
+                ? "Available until November 3, 23:59 UTC."
+                : "One-way exchange. Unspent Pumpkoins disappear after November 3 (UTC).",
+      });
+    }
+  }
+  return (
+    <>
+      <button className="back-link" onClick={onBack}>
+        <ArrowLeft size={14} /> All shelves
+      </button>
+      <section
+        className="rngween-limited-shop"
+        id="shop-limited"
+        aria-labelledby="limited-shop-title"
+      >
+        <header className="rngween-limited-heading">
+          <PumpkinMark size={48} />
+          <div>
+            <span className="rngween-limited-kicker">
+              October 21–November 3, 2026 · UTC
+            </span>
+            <h1 id="limited-shop-title" ref={heading} tabIndex={-1}>
+              Limited Shop: RNGween 2026
+            </h1>
+            <p>Spend the season. Keep the treats.</p>
+          </div>
+          {live && (
+            <span className="rngween-limited-time">
+              <Clock size={13} /> {waitText(calendar.limitedEndsAt - now)} left
+            </span>
+          )}
+        </header>
+        {!live ? (
+          <div className="rngween-shop-closed" role="status">
+            <h2>
+              {calendar.limitedPhase === "unavailable"
+                ? "Checking the website calendar…"
+                : calendar.limitedPhase === "upcoming"
+                  ? "The shelves open October 21"
+                  : "The lanterns have gone out"}
+            </h2>
+            <p>
+              {calendar.limitedPhase === "ended" || limited?.retired
+                ? "The shop, Pumpkoins, temporary companion, skill and world have retired. Your collected auras and Hexbound skin are still yours."
+                : "This one-time shop uses the website's verified UTC calendar, not your device date."}
+            </p>
+          </div>
+        ) : (
+          <>
+            {!progress.profile && (
+              <div className="guest-save-notice">
+                <p>
+                  Create a profile to save purchases, Pumpkoins and your world
+                  pool.
+                </p>
+                <button className="secondary-button" onClick={openSignup}>
+                  Sign up to save
+                </button>
+              </div>
+            )}
+            <div className="rngween-economy">
+              <div className="rngween-currency-wallet">
+                <Pumpkoin size={32} />
+                <span>Your seasonal wallet</span>
+                <strong data-pumpkoins={wallet}>{count(wallet)}</strong>
+                <span>Pumpkoins</span>
+                <p>
+                  Only for RNGween 2026. Unspent coins disappear after November
+                  3. No refunds.
+                </p>
+              </div>
+              <form
+                className="rngween-exchange"
+                onSubmit={(event) => {
+                  event.preventDefault();
+                  if (valid && progress.profile) {
+                    setError("");
+                    setConfirmation({
+                      action: { type: "exchange-pumpkoins", amount },
+                      amount,
+                    });
+                  }
+                }}
+              >
+                <h2>
+                  <ArrowRightLeft size={18} /> EP → Pumpkoins
+                </h2>
+                <p>
+                  {formatEP(EP_PER_PUMPKOIN)} EP = 1 Pumpkoin · one-way exchange
+                </p>
+                <label htmlFor="pumpkoin-quantity">Pumpkoins to receive</label>
+                <div className="rngween-exchange-input">
+                  <input
+                    id="pumpkoin-quantity"
+                    type="number"
+                    inputMode="numeric"
+                    min="1"
+                    max={max || 1}
+                    step="1"
+                    value={quantity}
+                    onChange={(event) => setQuantity(event.target.value)}
+                  />
+                  <button
+                    type="button"
+                    className="secondary-button"
+                    onClick={() => setQuantity(String(max))}
+                    disabled={!max || pending}
+                  >
+                    Max
+                  </button>
+                </div>
+                <span className="rngween-exchange-cost">
+                  Cost:{" "}
+                  {formatEP(
+                    Number.isSafeInteger(amount * EP_PER_PUMPKOIN) && amount > 0
+                      ? amount * EP_PER_PUMPKOIN
+                      : 0,
+                  )}{" "}
+                  EP · wallet {formatEP(progress.balance)} EP
+                </span>
+                <button
+                  className="primary-button"
+                  type="submit"
+                  disabled={!valid || pending || !progress.profile}
+                >
+                  Exchange EP for Pumpkoins
+                </button>
+              </form>
+            </div>
+            <div className="rngween-shop-world">
+              <Sparkles size={24} />
+              <div>
+                <h2>RNGween World is open to everyone</h2>
+                <p>
+                  Collect badges in Graveyard and Haunted House for two key
+                  fragments. Forge your Valley challenge key for free, or buy
+                  the 2,000 Pumpkoin shortcut below. Speak to The Reaper below
+                  Roll to enter. Find 6666 in the Valley for permanent Hexbound.
+                </p>
+              </div>
+              <button className="secondary-button" onClick={onWorld}>
+                Find The Reaper
+                <ArrowRight size={14} />
+              </button>
+            </div>
+            <div className="rngween-limited-section-title">
+              <h2>Event items</h2>
+              <p>
+                The familiar, skill and key leave after November 3. Earned auras
+                stay forever.
+              </p>
+            </div>
+            <div className="rngween-limited-grid">
+              {items.map((item) => {
+                const saleLocked =
+                  item.kind === "aura" && !calendar.aurasBuyable;
+                const owned =
+                  item.kind === "aura"
+                    ? progress.owned.includes(item.id)
+                    : (limited?.bought ?? []).includes(item.id);
+                const equipped =
+                  item.id === RNGWEEN_PET.id
+                    ? progress.activePet === item.id
+                    : item.id === RNGWEEN_SKILL.id
+                      ? progress.equippedSkills.includes(item.id)
+                      : progress.equipped === item.id;
+                return (
+                  <article
+                    className="rngween-limited-card"
+                    key={item.id}
+                    data-limited-item={item.id}
+                  >
+                    <div
+                      className={`rngween-limited-preview ${item.kind === "aura" ? "is-aura" : ""}`}
+                      aria-hidden="true"
+                    >
+                      {item.kind === "aura" ? (
+                        <NumberBox
+                          value="6666"
+                          tier="rare"
+                          aura={item.id}
+                          compact
+                        />
+                      ) : item.kind === "companion" ? (
+                        <PetIcon
+                          pet={item.id}
+                          multiplier={item.multiplier}
+                          active={equipped}
+                          size={94}
+                        />
+                      ) : item.kind === "world-key" ? (
+                        <WorldKeyMark
+                          size={78}
+                          className="rngween-world-key-art"
+                        />
+                      ) : (
+                        <SkillIcon icon={item.icon} size={74} />
+                      )}
+                    </div>
+                    <span className="rngween-limited-kind">
+                      {item.kind === "aura"
+                        ? "Permanent aura · task fallback"
+                        : item.kind === "world-key"
+                          ? "Valley access · until Nov 3 UTC"
+                          : `Temporary ${item.kind} · until Nov 3`}
+                    </span>
+                    <h3>
+                      {item.name}
+                      {owned && <Check size={15} />}
+                    </h3>
+                    <p>{item.description}</p>
+                    {saleLocked && (
+                      <p className="rngween-aura-sale-note">
+                        <Clock size={13} /> Purchases open November 1 UTC. Earn
+                        this aura from tasks until October 31.
+                      </p>
+                    )}
+                    <strong className="rngween-limited-price">
+                      <Pumpkoin size={18} />
+                      {count(item.pumpkoinPrice)} Pumpkoins
+                    </strong>
+                    {item.kind === "world-key" && (unlocked || readyToForge) ? (
+                      <>
+                        <span className="rngween-key-status">
+                          <Check size={14} />
+                          {owned
+                            ? "Valley key owned"
+                            : readyToForge && !unlocked
+                              ? "Both fragments ready · forge for free"
+                              : "Valley challenge unlocked"}
+                        </span>
+                        <button className="secondary-button" onClick={onWorld}>
+                          View World <ArrowRight size={14} />
+                        </button>
+                      </>
+                    ) : owned ? (
+                      <button
+                        className="secondary-button"
+                        disabled={
+                          pending || (item.kind === "companion" && equipped)
+                        }
+                        onClick={() =>
+                          run({
+                            type:
+                              item.kind === "companion"
+                                ? "equip-pet"
+                                : "equip-skill",
+                            id: item.id,
+                            ...(item.kind === "skill"
+                              ? { equipped: !equipped }
+                              : {}),
+                          })
+                        }
+                      >
+                        {equipped
+                          ? item.kind === "skill"
+                            ? "Unequip skill"
+                            : "Companion equipped"
+                          : `Equip ${item.kind}`}
+                      </button>
+                    ) : (
+                      <button
+                        className="primary-button"
+                        disabled={
+                          pending ||
+                          saleLocked ||
+                          wallet < item.pumpkoinPrice ||
+                          !progress.profile
+                        }
+                        onClick={() => {
+                          setError("");
+                          setConfirmation({
+                            item,
+                            action: {
+                              type: "buy-rngween-limited",
+                              id: item.id,
+                            },
+                          });
+                        }}
+                        aria-label={`Buy ${item.name} for ${item.pumpkoinPrice} Pumpkoins`}
+                      >
+                        {saleLocked ? (
+                          "Available November 1"
+                        ) : (
+                          <>
+                            Buy for {count(item.pumpkoinPrice)}{" "}
+                            <Pumpkoin size={16} />
+                          </>
+                        )}
+                      </button>
+                    )}
+                  </article>
+                );
+              })}
+              <article
+                className="rngween-limited-card rngween-world-prize"
+                data-world-prize={RNGWEEN_WORLD_SKIN.id}
+              >
+                <div
+                  className="rngween-limited-preview is-aura"
+                  aria-hidden="true"
+                >
+                  <NumberBox
+                    value="6666"
+                    tier="mythic"
+                    aura={RNGWEEN_WORLD_SKIN.id}
+                    compact
+                  />
+                </div>
+                <span className="rngween-limited-kind">
+                  Permanent aura · world reward
+                </span>
+                <h3>
+                  {RNGWEEN_WORLD_SKIN.name}
+                  {hexboundOwned && <Check size={15} />}
+                </h3>
+                <p>{RNGWEEN_WORLD_SKIN.description}</p>
+                <strong className="rngween-world-prize-condition">
+                  <HexboundMark size={19} />
+                  Find 6666 · never sold
+                </strong>
+                {hexboundOwned ? (
+                  <button
+                    className="secondary-button"
+                    disabled={
+                      pending || progress.equipped === RNGWEEN_WORLD_SKIN.id
+                    }
+                    onClick={async () => {
+                      if (
+                        await run({ type: "equip", id: RNGWEEN_WORLD_SKIN.id })
+                      )
+                        notify?.({
+                          kind: "done",
+                          text: "Hexbound equipped.",
+                        });
+                    }}
+                  >
+                    {progress.equipped === RNGWEEN_WORLD_SKIN.id
+                      ? "Hexbound equipped"
+                      : "Equip Hexbound"}
+                  </button>
+                ) : (
+                  <button className="secondary-button" onClick={onWorld}>
+                    Explore RNGween World
+                    <ArrowRight size={14} />
+                  </button>
+                )}
+              </article>
+            </div>
+            {items.every((item) => item.kind !== "aura") && (
+              <p className="rngween-all-auras">
+                All four task auras are already in your collection.
+              </p>
+            )}
+            {progress.owned.some((id) =>
+              [
+                "jack-o-glow",
+                "phantom-veil",
+                "witchfire",
+                "blood-moon",
+                "hexbound",
+              ].includes(id),
+            ) && (
+              <button className="secondary-button" onClick={onCollection}>
+                Your permanent Halloween collection <ArrowRight size={14} />
+              </button>
+            )}
+            {error && !confirmation && (
+              <p className="rngween-shop-error" role="alert">
+                {error}
+              </p>
+            )}
+            <p className="rngween-limited-footnote">
+              Tasks close October 31; aura purchases open November 1. Shop,
+              exchange and world close November 3 at 23:59 UTC. No EP, task
+              progress or main-game rolls are awarded by the mini RNG.
+            </p>
+          </>
+        )}
+      </section>
+      <dialog
+        className="rngween-buy-dialog"
+        ref={dialog}
+        aria-labelledby="rngween-confirm-title"
+        onCancel={(event) => {
+          event.preventDefault();
+          if (!pending) setConfirmation(null);
+        }}
+      >
+        {confirmation && (
+          <>
+            <Pumpkoin size={38} />
+            <h2 id="rngween-confirm-title">
+              {confirmation.item?.kind === "world-key"
+                ? "Buy a Valley Challenge Key?"
+                : confirmation.item
+                  ? `Collect ${confirmation.item.name}?`
+                  : `Exchange for ${count(confirmation.amount)} Pumpkoins?`}
+            </h2>
+            <p>
+              {confirmation.item
+                ? `${count(confirmation.item.pumpkoinPrice)} Pumpkoins. ${confirmation.item.kind === "aura" ? "This aura is yours forever." : "This item expires after November 3 (UTC)."}`
+                : `${formatEP(confirmation.amount * EP_PER_PUMPKOIN)} EP will be spent. This exchange cannot be reversed; unused coins disappear after November 3 (UTC).`}
+            </p>
+            {confirmation.item?.kind === "world-key" && (
+              <p>
+                The first three World phases are already free. This key unlocks
+                only Valley of Horrors and is never consumed by entering or
+                rebirth. No refunds, no mission completion, no aura or Hexbound
+                included. Complete both zones' badge objectives and forge a free
+                key instead.
+              </p>
+            )}
+            {error && (
+              <p className="rngween-shop-error" role="alert">
+                {error}
+              </p>
+            )}
+            <div>
+              <button
+                className="secondary-button"
+                disabled={pending}
+                onClick={() => setConfirmation(null)}
+              >
+                Cancel
+              </button>
+              <button
+                className="primary-button"
+                disabled={pending || !live}
+                onClick={confirm}
+              >
+                {pending
+                  ? "Saving…"
+                  : confirmation.item
+                    ? "Confirm purchase"
+                    : "Confirm exchange"}
+              </button>
+            </div>
+          </>
+        )}
+      </dialog>
+    </>
+  );
+}
diff --git a/src/components/RngweenTasks.jsx b/src/components/RngweenTasks.jsx
new file mode 100644
index 0000000..f1b8e4d
--- /dev/null
+++ b/src/components/RngweenTasks.jsx
@@ -0,0 +1,203 @@
+import React, { useRef, useState } from "react";
+import { ArrowUpRight, Check, Gift, Timer } from "lucide-react";
+import { rngweenState } from "../rngween.js";
+import { productById } from "../shop-data.js";
+import { waitText } from "../tasks.js";
+import { formatEP } from "../roll-data.js";
+import NumberBox from "./NumberBox";
+import { PumpkinMark } from "./game-icons.jsx";
+import "../rngween.css";
+
+function countText(mission) {
+  if (mission.metric === "banked")
+    return `${formatEP(mission.count)} / ${formatEP(mission.goal)} EP`;
+  const unit =
+    mission.metric === "rare"
+      ? "Rare+"
+      : mission.metric === "taskClaims"
+        ? "tasks"
+        : "rolls";
+  return `${mission.count} / ${mission.goal} ${unit}`;
+}
+
+export default function RngweenTasks({
+  progress,
+  now,
+  onAction,
+  notify,
+  openAuraFamily,
+}) {
+  const event = rngweenState(progress.tasks, now);
+  const [pending, setPending] = useState("");
+  const busy = useRef(false);
+  if (event.phase !== "active") return null;
+  const hasCollection = progress.owned.some(
+    (id) => productById.get(id)?.eventOnly,
+  );
+
+  async function collect(mission) {
+    if (busy.current) return;
+    busy.current = true;
+    setPending(mission.id);
+    try {
+      const outcome = await onAction({
+        type: "claim-rngween-aura",
+        id: mission.id,
+      });
+      notify?.(
+        outcome?.ok
+          ? {
+              kind: "reward",
+              title: `${productById.get(mission.auraId).name} collected`,
+              text: `+${mission.pumpkoins} Pumpkoins. Aura added to your collection. Pumpkoins expire after November 3 UTC.`,
+            }
+          : {
+              kind: "error",
+              text:
+                outcome?.message ??
+                "That Halloween aura could not be collected yet.",
+            },
+      );
+    } finally {
+      busy.current = false;
+      setPending("");
+    }
+  }
+
+  return (
+    <section
+      className="rngween-event"
+      data-event-phase="active"
+      aria-labelledby="rngween-event-title"
+    >
+      <header className="rngween-event-head">
+        <span className="rngween-event-icon" aria-hidden="true">
+          <PumpkinMark size={34} />
+        </span>
+        <div>
+          <span className="rngween-eyebrow">
+            One-time Halloween event · Oct 25–31, 2026 · UTC
+          </span>
+          <h2 id="rngween-event-title">RNGween</h2>
+          <p>Complete four tasks for Halloween auras.</p>
+        </div>
+        <span className="rngween-live">Live</span>
+      </header>
+      <div className="rngween-event-intro">
+        <p>
+          Complete and claim these tasks by October 31 UTC for their auras and
+          Pumpkoins. Missing auras go on sale in Limited Shop November 1–3.
+          Collected auras survive resets and will not return after this event.
+          World badges are separate; speak to The Reaper below Roll to play.
+        </p>
+        {hasCollection && (
+          <button
+            className="secondary-button"
+            onClick={() => openAuraFamily?.("rngween")}
+          >
+            Your Halloween collection{" "}
+            <ArrowUpRight size={14} aria-hidden="true" />
+          </button>
+        )}
+      </div>
+      <div className="rngween-event-progress">
+        <span>
+          <strong>
+            {event.collected} / {event.total}
+          </strong>{" "}
+          auras collected
+        </span>
+        <span>
+          <Timer size={13} aria-hidden="true" /> Ends in{" "}
+          {waitText(event.endsAt - now)}
+        </span>
+        <progress
+          max={event.total}
+          value={event.collected}
+          aria-label="RNGween event progress"
+        />
+      </div>
+      <ul className="rngween-missions" aria-label="Halloween tasks">
+        {event.missions.map((mission, index) => {
+          const aura = productById.get(mission.auraId);
+          const state = mission.collected
+            ? "collected"
+            : mission.claimable
+              ? "claimable"
+              : "open";
+          return (
+            <li
+              key={mission.id}
+              className="rngween-mission"
+              data-event-mission={mission.id}
+              data-state={state}
+              style={{
+                "--treat-a": aura.swatch[0],
+                "--treat-b": aura.swatch[1],
+              }}
+            >
+              <div className="rngween-mission-top">
+                <span>Task {String(index + 1).padStart(2, "0")}</span>
+                <span>
+                  {mission.collected
+                    ? "Collected"
+                    : mission.claimable
+                      ? "Ready to collect"
+                      : "In progress"}
+                </span>
+              </div>
+              <div className="rngween-mission-preview" aria-hidden="true">
+                <NumberBox value="131031" tier="rare" aura={aura.id} compact />
+              </div>
+              <h3>{mission.title}</h3>
+              <p>{mission.detail}</p>
+              <div className="rngween-mission-meter">
+                <span>
+                  {mission.collected
+                    ? "Collected · yours forever"
+                    : countText(mission)}
+                </span>
+                <progress
+                  max={mission.goal}
+                  value={mission.collected ? mission.goal : mission.count}
+                  aria-label={`${mission.title} progress`}
+                />
+              </div>
+              <div className="rngween-mission-reward">
+                <Gift size={14} aria-hidden="true" />
+                <strong>
+                  {aura.name} + {mission.pumpkoins} Pumpkoins
+                </strong>
+                <span>2026 exclusive</span>
+              </div>
+              <button
+                className={
+                  mission.claimable ? "primary-button" : "secondary-button"
+                }
+                disabled={!mission.claimable || !!pending}
+                onClick={() => collect(mission)}
+                aria-label={`Collect ${aura.name}`}
+              >
+                {mission.collected ? (
+                  <>
+                    <Check size={14} aria-hidden="true" /> In your collection
+                  </>
+                ) : pending === mission.id ? (
+                  "Collecting…"
+                ) : mission.claimable ? (
+                  `Collect ${aura.name}`
+                ) : (
+                  "Complete task to collect"
+                )}
+              </button>
+            </li>
+          );
+        })}
+      </ul>
+      <p className="rngween-event-note">
+        Online rolls only. Claim each aura and its Pumpkoins together; no EP is
+        spent. Finish and collect by 23:59 UTC on October 31.
+      </p>
+    </section>
+  );
+}
diff --git a/src/components/RngweenWorld.jsx b/src/components/RngweenWorld.jsx
new file mode 100644
index 0000000..23e1ae1
--- /dev/null
+++ b/src/components/RngweenWorld.jsx
@@ -0,0 +1,816 @@
+import React, { useEffect, useRef, useState } from "react";
+import {
+  ArrowLeft,
+  ArrowRight,
+  Check,
+  Clock3,
+  DoorClosed,
+  Flame,
+  Ghost,
+  Hourglass,
+  KeyRound,
+  LockKeyhole,
+  Moon,
+  ShoppingBag,
+  Skull,
+  X,
+} from "lucide-react";
+import { RNGWEEN_WORLD_SKIN, rngweenCalendar } from "../rngween.js";
+import { RNGWEEN_WORLD_MAX } from "../rngween-limited.js";
+import {
+  WORLD_ZONES,
+  WORLD_SPEED_ITEMS,
+  WORLD_VALLEY_TARGET,
+  worldZoneById,
+  worldState,
+  worldRevealMS,
+  rngweenValleyUnlocked,
+} from "../rngween-world-zones.js";
+import {
+  WORLD_MINI_RULES,
+  emptyWorldMini,
+  scoreWorldNumber,
+  worldPhaseComplete,
+} from "../rngween-world-badges.js";
+import { seasonNow } from "../season-clock.js";
+import { hourlyView, hourlyTaskById } from "../rngween-hourly.js";
+import { useMotionPreference } from "../use-settings.jsx";
+import { useModalDialog } from "../use-modal-dialog.js";
+import NumberBox from "./NumberBox.jsx";
+import WorldScenery from "./WorldScenery.jsx";
+import ReaperFigure from "./ReaperFigure.jsx";
+import ReaperDialog from "./ReaperDialog.jsx";
+import RngweenHourly from "./RngweenHourly.jsx";
+import WorldAuraTrial from "./WorldAuraTrial.jsx";
+import WorldCollection, { WorldResultBadges } from "./WorldCollection.jsx";
+import { Pumpkoin } from "./RngweenShop.jsx";
+import { HexboundMark, PumpkinMark } from "./game-icons.jsx";
+import "../rngween-limited.css";
+import "../rngween-world.css";
+
+const ZONE_ICONS = {
+  "pumpkin-patch": PumpkinMark,
+  graveyard: Skull,
+  "haunted-house": DoorClosed,
+  valley: Flame,
+};
+const SPEED_ICONS = [Moon, Clock3, Hourglass];
+// Scenery never consumes gameplay randomness.
+
+function useRevealClock(now, pending, reduced) {
+  const [clock, setClock] = useState(() => seasonNow() ?? now);
+  useEffect(() => {
+    setClock(seasonNow() ?? now);
+    if (!pending) return;
+    const tick = () => setClock(seasonNow() ?? now);
+    const timer = window.setInterval(tick, reduced ? 250 : 80);
+    return () => window.clearInterval(timer);
+  }, [now, pending?.id, reduced]);
+  return clock;
+}
+
+// CLEANUP Nov 4, 2026: remove this event-only view and speed shelf. Permanent
+// Hexbound remains in Shop; saved pending outcomes are settled/retired safely.
+export default function RngweenWorld({
+  progress,
+  now,
+  onAction,
+  onBack,
+  onShop,
+  onTasks,
+  openSignup,
+  warning,
+}) {
+  const world = worldState(progress.rngweenLimited);
+  const limited = progress.rngweenLimited;
+  const drawn = limited?.drawn ?? [];
+  const wallet = limited?.pumpkoins ?? 0;
+  const reduced = useMotionPreference();
+  const [selected, setSelected] = useState(
+    () => world.pending?.zone ?? world.last?.zone ?? "pumpkin-patch",
+  );
+  const [shopOpen, setShopOpen] = useState(false);
+  const [reaperOpen, setReaperOpen] = useState(false);
+  const [commissionsOpen, setCommissionsOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const sending = useRef(false);
+  const shopDialog = useModalDialog(shopOpen);
+  const pending = world.pending;
+  const zone = worldZoneById.get(pending?.zone ?? selected);
+  const ZoneIcon = ZONE_ICONS[zone.id];
+  const clock = useRevealClock(now, pending, reduced);
+  const stats = world.mini?.[zone.id] ?? emptyWorldMini()[zone.id];
+  const savedLast = stats.last
+    ? {
+        ...stats.last,
+        id: `rngween-2026:world:${stats.last.serial}`,
+        zone: zone.id,
+        rules: WORLD_MINI_RULES,
+        revealsAt: stats.last.at,
+      }
+    : null;
+  const globalLast = world.last?.zone === zone.id ? world.last : null;
+  const last =
+    globalLast && (!savedLast || globalLast.serial > savedLast.serial)
+      ? globalLast
+      : (savedLast ?? globalLast);
+  const result =
+    last?.rules === WORLD_MINI_RULES
+      ? scoreWorldNumber(zone.id, last.number)
+      : null;
+  const aura = progress.owned.includes(progress.equipped)
+    ? progress.equipped
+    : "none";
+  const live =
+    rngweenCalendar(now).limitedPhase === "active" && !limited?.retired;
+  const key = rngweenValleyUnlocked(limited);
+  const fragments =
+    Number(world.fragments.graveyard) +
+    Number(world.fragments["haunted-house"]);
+  const exhausted = drawn.length >= RNGWEEN_WORLD_MAX;
+  const duration = pending
+    ? pending.revealsAt - pending.startedAt
+    : worldRevealMS(limited);
+  const elapsed = pending
+    ? Math.max(
+        0,
+        Math.min(duration, (clock ?? pending.startedAt) - pending.startedAt),
+      )
+    : duration;
+  const fraction = duration ? elapsed / duration : 0;
+  const remaining = pending ? Math.max(0, duration - elapsed) : 0;
+  const visibleCount = pending
+    ? Math.min(zone.digits - 1, Math.floor(fraction * zone.digits))
+    : zone.digits;
+  const outcome = pending ?? last;
+  const digits = outcome
+    ? String(outcome.number).padStart(zone.digits, "0")
+    : "?".repeat(zone.digits);
+  const jackpot =
+    !pending && last?.zone === "valley" && last.number === WORLD_VALLEY_TARGET;
+  const hourly = hourlyView(progress, now);
+  const commissionPaid =
+    !pending && last && world.last?.serial === last.serial
+      ? progress.history
+          .filter(
+            (entry) =>
+              entry.type === "rngween-hourly" &&
+              entry.at >= last.revealsAt &&
+              hourlyTaskById.get(entry.taskId)?.source === "world",
+          )
+          .reduce((sum, entry) => sum + entry.pumpkoins, 0)
+      : 0;
+  async function run(action, success) {
+    if (sending.current) return;
+    sending.current = true;
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      const result = await onAction(action);
+      if (!result?.ok)
+        setError(result?.message ?? "Nothing was saved. Try again.");
+      else if (success) setNotice(success);
+    } finally {
+      sending.current = false;
+      setBusy(false);
+    }
+  }
+  function closeShop() {
+    if (!sending.current) {
+      setShopOpen(false);
+      setError("");
+    }
+  }
+  const resultText = !last
+    ? `Roll for your first ${zone.name} badges.`
+    : jackpot
+      ? "6666 — Hexbound unlocked."
+      : result
+        ? `${result.tier[0].toUpperCase() + result.tier.slice(1)} · +${result.points.toLocaleString("en-US")} event points`
+        : "Saved legacy result settled. Existing rewards are kept.";
+
+  return (
+    <main
+      className={`rngween-world${reduced ? " world-motion-reduced" : ""}`}
+      style={{ "--world-accent": zone.accent }}
+    >
+      <header className="world-header">
+        <button className="world-back" onClick={onBack}>
+          <ArrowLeft size={16} />
+          Back to Roll
+        </button>
+        <button
+          className="world-talk-button"
+          onClick={() => setReaperOpen(true)}
+          aria-haspopup="dialog"
+        >
+          <ReaperFigure />
+          Talk to The Reaper
+        </button>
+        <span className="world-event-date">RNGween 2026 · until Nov 3 UTC</span>
+        <button
+          className="world-wallet"
+          aria-label={`World shop · ${wallet.toLocaleString("en-US")} Pumpkoins`}
+          onClick={() => {
+            setShopOpen(true);
+            setError("");
+            setNotice("");
+          }}
+          aria-haspopup="dialog"
+        >
+          <Pumpkoin size={20} />
+          <strong>{wallet.toLocaleString("en-US")}</strong>
+          <ShoppingBag size={16} />
+          <span>World shop</span>
+        </button>
+      </header>
+      <div className="world-heading">
+        <span className="world-eyebrow">
+          <PumpkinMark size={17} />
+          The Halloween mini-RNGdle
+        </span>
+        <h1>RNGween World</h1>
+        <p>
+          {key
+            ? "Valley unlocked. Find 6666 to earn Hexbound."
+            : "Earn both key fragments, or buy a Valley Challenge Key."}
+        </p>
+      </div>
+      {warning && (
+        <p className="world-alert" role="alert">
+          {warning}
+        </p>
+      )}
+      {!progress.profile && (
+        <div className="world-guest">
+          <Ghost size={22} />
+          <p>
+            The World is open to everyone. Create a profile to save rolls, key
+            fragments, badge collections and your permanent prize.
+          </p>
+          <button className="primary-button" onClick={openSignup}>
+            Create profile
+          </button>
+        </div>
+      )}
+      <nav className="world-zones" aria-label="World phases">
+        {WORLD_ZONES.map((item) => {
+          const Icon = ZONE_ICONS[item.id];
+          const active = zone.id === item.id;
+          const complete = worldPhaseComplete(item.id, world.mini?.[item.id]);
+          const ready = item.fragment
+            ? world.fragments[item.fragment]
+            : item.id === "valley"
+              ? key
+              : complete;
+          return (
+            <button
+              key={item.id}
+              className={`world-zone${active ? " is-selected" : ""}`}
+              style={{ "--zone-accent": item.accent }}
+              aria-pressed={active}
+              disabled={!!pending || busy}
+              onClick={() => {
+                setSelected(item.id);
+                setError("");
+                setNotice("");
+              }}
+              data-world-zone={item.id}
+            >
+              <span className="world-zone-glyph">
+                <Icon size={24} />
+              </span>
+              <span className="world-zone-number">Phase 0{item.phase}</span>
+              <strong>{item.name}</strong>
+              <span>{item.subtitle}</span>
+              <small>
+                {item.id === "pumpkin-patch" ? (
+                  complete ? (
+                    <>
+                      <Check size={12} />
+                      Objectives cleared
+                    </>
+                  ) : (
+                    "Free entry"
+                  )
+                ) : item.fragment ? (
+                  ready ? (
+                    <>
+                      <Check size={12} />
+                      Fragment found
+                    </>
+                  ) : (
+                    "Key fragment"
+                  )
+                ) : ready ? (
+                  <>
+                    <KeyRound size={12} />
+                    Challenge unlocked
+                  </>
+                ) : (
+                  <>
+                    <LockKeyhole size={12} />
+                    Challenge key needed
+                  </>
+                )}
+              </small>
+            </button>
+          );
+        })}
+      </nav>
+      <div className="world-workbench">
+        <section
+          className={`world-playground${pending ? " is-revealing" : ""}${jackpot ? " is-jackpot" : ""}`}
+          data-zone={zone.id}
+          aria-labelledby="world-zone-title"
+        >
+          <div className="world-scene">
+            <WorldScenery zone={zone.id} />
+            <span className="world-fog world-fog-back" />
+            <span className="world-fog world-fog-front" />
+            <span className="world-wisps" aria-hidden="true">
+              {[0, 1, 2, 3, 4, 5].map((i) => (
+                <i key={i} style={{ "--wisp": i }} />
+              ))}
+            </span>
+          </div>
+          <div className="world-zone-heading">
+            <span className="world-eyebrow">
+              <ZoneIcon size={15} />
+              Phase 0{zone.phase} · {zone.subtitle}
+            </span>
+            <h2 id="world-zone-title">{zone.name}</h2>
+            <p>{zone.detail}</p>
+          </div>
+          {pending && pending.rules !== WORLD_MINI_RULES && (
+            <p className="world-legacy-note">
+              Finishing a saved roll under its original rules. Your next roll
+              starts the badge hunt.
+            </p>
+          )}
+          <div className="world-result-stage">
+            <div
+              className={`world-summoning-circle${pending ? " is-spinning" : ""}`}
+              aria-hidden="true"
+            >
+              <span>✦</span>
+              <span>✧</span>
+              <span>✦</span>
+              <span>✧</span>
+              <span>✦</span>
+              <span>✧</span>
+            </div>
+            <NumberBox
+              value={"?".repeat(zone.digits)}
+              aura={aura}
+              auraLayout="contained"
+              tier={
+                !pending && result
+                  ? result.tier === "legendary"
+                    ? "mythic"
+                    : result.tier
+                  : "neutral"
+              }
+              className={`world-number-box${pending ? " is-revealing" : ""}`}
+              aria-label={
+                pending || !last
+                  ? "Waiting for a World result"
+                  : `World number ${last.number}`
+              }
+              data-world-result={
+                pending ? "pending" : last ? "revealed" : "empty"
+              }
+            >
+              <span className="world-result-digits" aria-hidden="true">
+                {Array.from(digits).map((digit, i) => {
+                  const shown = (!pending || i < visibleCount) && !!outcome;
+                  return (
+                    <span
+                      key={`${outcome?.serial ?? "empty"}:${i}:${shown}`}
