+@keyframes world-mist-drift {
+  from {
+    transform: translateX(-6%);
+  }
+  to {
+    transform: translateX(7%);
+  }
+}
+@keyframes world-wisp-float {
+  0%,
+  100% {
+    transform: translateY(10px);
+    opacity: 0.2;
+  }
+  50% {
+    transform: translate(7px, -20px);
+    opacity: 0.7;
+  }
+}
+@keyframes world-candlelight {
+  0%,
+  100% {
+    opacity: 0.8;
+  }
+  46% {
+    opacity: 0.35;
+  }
+  52% {
+    opacity: 0.7;
+  }
+  68% {
+    opacity: 0.5;
+  }
+}
+@keyframes world-digit-wait {
+  0%,
+  100% {
+    opacity: 0.3;
+    transform: translateY(1px);
+  }
+  50% {
+    opacity: 0.8;
+    transform: translateY(-2px);
+  }
+}
+@keyframes world-digit-arrive {
+  from {
+    opacity: 0.3;
+    filter: blur(5px);
+    transform: translateY(-8px);
+  }
+  to {
+    opacity: 1;
+    filter: none;
+    transform: none;
+  }
+}
+@keyframes world-ghost-rise {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+@keyframes world-summon {
+  to {
+    transform: rotate(350deg);
+  }
+}
+.world-motion-reduced *,
+.world-motion-reduced *::before,
+.world-motion-reduced *::after {
+  animation: none !important;
+  transition: none !important;
+}
+@media (prefers-reduced-motion: reduce) {
+  .rngween-world *,
+  .rngween-world *::before,
+  .rngween-world *::after,
+  .world-shop-dialog * {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+@media (max-width: 680px) {
