+// Developer fixture, never imported by the app. Only the explicit unlocked
+// review server injects it, on an empty origin; reloads never refill a save.
+import { applyProgress, emptyProgress, PROGRESS_KEY } from "../src/progress.js";
+import { defaultSettings, SETTINGS_KEY } from "../src/settings.js";
+import {
+  RNGWEEN_ID,
+  RNGWEEN_AURAS,
+  RNGWEEN_MISSIONS,
+  RNGWEEN_COSMETICS,
+} from "../src/rngween.js";
+import {
+  RNGWEEN_PET,
+  RNGWEEN_SIGNATURE,
+  RNGWEEN_SKILL,
+  RNGWEEN_WORLD_KEY,
+  RNGWEEN_WORLD_TARGET,
+} from "../src/rngween-limited.js";
+import {
+  emptyRngweenWorld,
+  WORLD_SPEED_ITEMS,
+} from "../src/rngween-world-zones.js";
+import { flywheelRequired } from "../src/flywheel.js";
+import { skillById } from "../src/skills.js";
+
+export function unlockedRngweenPreview() {
+  const base = emptyProgress();
+  const owned = [
+    ...RNGWEEN_COSMETICS.map((item) => item.id),
+    RNGWEEN_SKILL.id,
+    "skill-bay-1",
+    "skill-bay-2",
+    "surge",
+    "twice",
+    "flywheel",
+    "auto-roll",
+    ...[1, 2, 3, 4].map((n) => `quickwind-${n}`),
+    ...[1, 2, 3, 4, 5, 6].map((n) => `clockwork-${n}`),
+  ];
+  const equippedSkills = [
+    RNGWEEN_SKILL.id,
+    "twice",
+    RNGWEEN_SIGNATURE.id,
+    "surge",
+  ];
+  const fixture = {
+    progressKey: PROGRESS_KEY,
+    settingsKey: SETTINGS_KEY,
+    settings: { ...defaultSettings, autoRollDefault: false },
+    progress: {
+      ...base,
+      profile: {
+        id: "rngween-unlocked-preview",
+        username: "RngweenSandbox",
+        createdAt: Date.UTC(2026, 9, 26, 12),
+      },
+      balance: 100000000,
+      totalEarned: 100000000,
+      owned,
+      equipped: "hexbound",
+      pets: [RNGWEEN_PET.id],
+      activePet: RNGWEEN_PET.id,
+      skills: [RNGWEEN_SKILL.id, "twice", "surge"],
+      equippedSkills,
+      skillCharge: Object.fromEntries(
+        equippedSkills.map((id) => [id, skillById.get(id).charges]),
+      ),
+      flywheelCharge: flywheelRequired(owned),
+      tasks: {
+        ...base.tasks,
+        rngween: {
+          id: RNGWEEN_ID,
+          counts: Object.fromEntries(
+            RNGWEEN_MISSIONS.map((mission) => [mission.metric, mission.goal]),
+          ),
+          earned: RNGWEEN_MISSIONS.map((mission) => mission.id),
+        },
+      },
+      rngweenLimited: {
+        ...base.rngweenLimited,
+        pumpkoins: 50000,
+        bought: [RNGWEEN_PET.id, RNGWEEN_SKILL.id],
+        drawn: [],
+        skinEarned: true,
+        auras: RNGWEEN_AURAS.map((aura) => aura.id),
+        world: {
+          ...emptyRngweenWorld(),
+          upgrades: WORLD_SPEED_ITEMS.map((item) => item.id),
+        },
+        rewardedMissions: RNGWEEN_MISSIONS.map((mission) => mission.id),
+      },
+    },
+  };
+  const samples = {
+    "pumpkin-patch": [1, 2, 3, 4, 5, 6, 7, 8, 9],
+    graveyard: [66, 13, 49, 66, 6, 12],
+    "haunted-house": [
+      666, 13, 123, 313, 111, 229, 343, 246, 123, 666, 111, 121,
+    ],
+    valley: [1234, 1354, 10, 1353, RNGWEEN_WORLD_TARGET],
+  };
+  let cursor =
+    Date.UTC(2026, 9, 26, 12) - Object.values(samples).flat().length * 2000;
+  for (const [zone, numbers] of Object.entries(samples)) {
+    if (zone === "valley") {
+      fixture.progress = applyProgress(fixture.progress, {
+        type: "forge-rngween-key",
+        at: cursor,
+      });
+      fixture.progress.rngweenLimited.bought.push(RNGWEEN_WORLD_KEY.id);
+    }
+    for (const number of numbers) {
+      fixture.progress = applyProgress(fixture.progress, {
+        type: "rngween-world-roll",
+        zone,
+        number,
+        expectedCount: fixture.progress.rngweenLimited.drawn.length,
+        at: cursor,
+      });
+      const pending = fixture.progress.rngweenLimited.world.pending;
+      cursor = pending.revealsAt;
+      fixture.progress = applyProgress(fixture.progress, {
+        type: "rngween-world-reveal",
+        id: pending.id,
+        at: cursor,
+      });
+    }
+  }
+  return fixture;
+}
diff --git a/tools/sandbox-clock.mjs b/tools/sandbox-clock.mjs
new file mode 100644
index 0000000..5cdcba7
--- /dev/null
+++ b/tools/sandbox-clock.mjs
@@ -0,0 +1,70 @@
+// Development-only review clock. `dev:rngween` or RNGDLE_SANDBOX_DATE selects
+// the date on the server, never in a player preference or public URL.
+// `apply: serve` keeps the override entirely out of production HTML and Pages.
+const CLOCK_PATH = "/__rngdle/season-clock";
+
+export function sandboxClock(value = process.env.RNGDLE_SANDBOX_DATE) {
+  if (!value) return null;
+  const epoch = Date.parse(value);
+  if (!Number.isFinite(epoch)) throw new Error("Invalid RNGDLE_SANDBOX_DATE");
+  const start = performance.now();
+  const now = () => Math.floor(epoch + performance.now() - start);
+  return {
+    name: "sandbox-review-clock",
+    apply: "serve",
+    configureServer(server) {
+      server.middlewares.use((req, res, next) => {
+        const url = new URL(req.url ?? "/", "http://vite.local");
+        // Preview proxies can replace Date or drop custom response headers.
+        // A same-origin JSON body preserves the server-selected review date.
+        if (req.method === "GET" && url.pathname === CLOCK_PATH) {
+          res.statusCode = 200;
+          res.setHeader("Content-Type", "application/json; charset=utf-8");
+          res.setHeader("Cache-Control", "no-store, max-age=0");
+          res.end(JSON.stringify({ at: now() }));
+          return;
+        }
+        if (req.method === "HEAD" && url.searchParams.has("season-clock")) {
+          const reviewDate = new Date(now()).toUTCString();
+          res.setHeader("Date", reviewDate);
+          res.setHeader("X-RNGdle-Sandbox-Date", reviewDate);
+          res.setHeader("Cache-Control", "no-store");
+        }
+        next();
+      });
+    },
+    transformIndexHtml: {
+      order: "pre",
+      handler() {
+        const reviewAt = now();
+        return [
+          {
+            tag: "meta",
+            attrs: { name: "rngdle-sandbox-clock", content: CLOCK_PATH },
+            injectTo: "head-prepend",
+          },
+          {
+            tag: "script",
+            attrs: { "data-sandbox-clock": "true" },
+            injectTo: "head-prepend",
+            children: `(() => {
+            const NativeDate = window.Date;
+            const tick = performance.now.bind(performance);
+            const start = tick();
+            const now = () => ${reviewAt} + Math.max(0, tick() - start);
+            window.Date = new Proxy(NativeDate, {
+              construct(target, args, next) {
+                return Reflect.construct(target, args.length ? args : [now()], next);
+              },
+              apply() { return new NativeDate(now()).toString(); },
+              get(target, key, receiver) {
+                return key === "now" ? now : Reflect.get(target, key, receiver);
+              }
+            });
+          })();`,
+          },
+        ];
+      },
+    },
+  };
+}
diff --git a/tools/sandbox-progress.mjs b/tools/sandbox-progress.mjs
new file mode 100644
index 0000000..842080c
--- /dev/null
+++ b/tools/sandbox-progress.mjs
@@ -0,0 +1,39 @@
+// Explicit developer mode only. No public URL flag, device-date control or
+// production account/economy bypass. Use a separate port/origin for the fixture.
+export function sandboxProgress(enabled = false) {
+  if (!enabled) return null;
+  return {
+    name: "sandbox-unlocked-progress",
+    apply: "serve",
+    transformIndexHtml: {
+      order: "pre",
+      async handler() {
+        // Lazy import: ordinary dev and every production build skip the fixture.
+        const { unlockedRngweenPreview } =
+          await import("./rngween-preview-data.mjs");
+        const payload = JSON.stringify(unlockedRngweenPreview()).replaceAll(
+          "<",
+          "\\u003c",
+        );
+        return [
+          {
+            tag: "script",
+            attrs: { "data-sandbox-unlocked": "true" },
+            injectTo: "head-prepend",
+            children: `(() => {
+            const seed = ${payload};
+            try {
+              if (localStorage.getItem(seed.progressKey) !== null) return;
+              localStorage.setItem(seed.progressKey, JSON.stringify(seed.progress));
+              if (localStorage.getItem(seed.settingsKey) === null)
+                localStorage.setItem(seed.settingsKey, JSON.stringify(seed.settings));
+              if (localStorage.getItem("rng-theme") === null)
+                localStorage.setItem("rng-theme", "dark");
+            } catch { /* Preview without storage falls back to ordinary guest play. */ }
+          })();`,
+          },
+        ];
+      },
+    },
+  };
+}
