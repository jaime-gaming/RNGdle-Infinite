{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rngdle-infinite",
  "main": "src/edge-worker.js",
  "compatibility_date": "2026-10-30",
  "vars": {
    "FIREBASE_PROJECT_ID": "rngdle-infinite-jg",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSessionDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameSessionDurableObject"],
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "rngdle-infinite.jaime-gaming.com",
      "custom_domain": true,
    },
  ],
}
