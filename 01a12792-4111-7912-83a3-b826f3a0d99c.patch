+    state.rngweenLimited?.retired ||
+    calendar.hourlyPhase !== "active"
+  )
+    return state;
+  const before = state.rngweenLimited?.hourly;
+  const current = refreshRngweenHourly(state, at, worldUnlocked);
+  const board = current.rngweenLimited.hourly;
+  if (board.window !== calendar.hourlyWindow) return current;
+  const previousIds = new Set(
+    before?.window === calendar.hourlyWindow
+      ? before.slots
+          .filter((slot) => slot.startedAt <= at && slot.expiresAt > at)
+          .map((slot) => slot.serial)
+      : [],
+  );
+  const next = {
+    ...board,
+    dealt: [...board.dealt],
+    slots: board.slots.map((slot) => ({ ...slot })),
+  };
+  const rewards = [];
+  for (let index = 0; index < next.slots.length; index++) {
+    const slot = next.slots[index];
+    const task = hourlyTaskById.get(slot.taskId);
+    const value = tally?.[task.metric];
+    if (
+      !previousIds.has(slot.serial) ||
+      slot.startedAt > startedAt ||
+      task.source !== source ||
+      !amount(value) ||
+      (!value && task.mode !== "streak")
+    )
+      continue;
+    const count =
+      task.mode === "streak"
+        ? value
+          ? slot.count + 1
+          : 0
+        : task.mode === "peak"
+          ? Math.max(slot.count, value)
+          : slot.count + value;
+    if (count < task.goal) {
+      next.slots[index] = { ...slot, count };
+      continue;
+    }
+    next.completed++;
+    next.earned += task.pumpkoins;
+    rewards.push({
+      id: `rngween-hourly:${calendar.hourlyWindow}:${slot.serial}`,
+      type: "rngween-hourly",
+      at,
+      taskId: task.id,
+      name: task.title,
+      pumpkoins: task.pumpkoins,
+    });
+    next.slots.splice(index, 1);
+    next.slots.splice(
+      index,
+      0,
+      deal(next, current, at, worldUnlocked, slot.taskId),
+    );
+  }
+  if (!rewards.length && JSON.stringify(next) === JSON.stringify(board))
+    return current;
+  const coins =
+    current.rngweenLimited.pumpkoins +
+    rewards.reduce((sum, reward) => sum + reward.pumpkoins, 0);
+  if (![coins, next.completed, next.earned].every(amount))
+    throw new Error("Pumpkoin balance limit reached.");
+  return {
+    ...current,
+    rngweenLimited: {
+      ...current.rngweenLimited,
+      pumpkoins: coins,
+      hourly: next,
+    },
+    history: [...current.history, ...rewards],
+  };
+}
diff --git a/src/rngween-intro.js b/src/rngween-intro.js
new file mode 100644
index 0000000..c32e35d
--- /dev/null
+++ b/src/rngween-intro.js
@@ -0,0 +1,20 @@
+import { RNGWEEN_ID } from "./rngween.js";
+
+// CLEANUP Nov 4, 2026: remove the welcome mount/helper. Keep the seen receipt
+// until then: it is local presentation, not an account reward or date control.
+export const RNGWEEN_INTRO_KEY = "rng-infinite-rngween-intro-v1";
+export function hasSeenRngweenIntro() {
+  try {
+    return localStorage.getItem(RNGWEEN_INTRO_KEY) === RNGWEEN_ID;
+  } catch {
+    return false;
+  }
+}
+export function markRngweenIntroSeen() {
+  try {
+    localStorage.setItem(RNGWEEN_INTRO_KEY, RNGWEEN_ID);
+    return true;
+  } catch {
+    return false;
+  }
+}
