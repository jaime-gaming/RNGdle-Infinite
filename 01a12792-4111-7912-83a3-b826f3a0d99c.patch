+    color-mix(in srgb, var(--rngween-purple, #7851a0) 5%, var(--surface)),
+    var(--surface) 45%,
+    color-mix(in srgb, var(--rngween-orange, #a14616) 4%, var(--surface))
+  );
+  box-shadow: var(--shadow);
+}
+.rngween-event-head {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 14px;
+  padding-bottom: 18px;
