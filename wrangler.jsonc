{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rngdle-infinite",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "rngdle-infinite.jaime-gaming.com",
      "custom_domain": true,
    },
  ],
}
