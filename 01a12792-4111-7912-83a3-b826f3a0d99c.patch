+/* CLEANUP Nov 4, 2026: remove the temporary commission board styles. */
+.rngween-hourly {
+  margin: 0 0 25px;
+  padding: clamp(17px, 3vw, 25px);
+  border: 1px solid color-mix(in srgb, #c4b5fd 25%, var(--border));
+  border-radius: 18px;
+  background: linear-gradient(
+    125deg,
+    color-mix(in srgb, #8b5cf6 5%, var(--surface)),
+    var(--surface) 55%,
+    color-mix(in srgb, #fb923c 5%, var(--surface))
+  );
+}
+.rngween-hourly-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 13px;
+}
+.rngween-hourly-mark {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  flex-shrink: 0;
+  border: 1px solid var(--border);
+  border-radius: 13px;
+  color: #a78bfa;
+  background: color-mix(in srgb, #8b5cf6 8%, var(--bg));
+}
+.rngween-hourly-head h2 {
+  font:
+    700 clamp(20px, 3vw, 27px)/1.25 Georgia,
+    serif;
+  margin: 5px 0;
+}
+.rngween-hourly-head p {
+  color: var(--secondary);
+  font-size: 11px;
+  line-height: 1.7;
+  margin: 0;
+}
+.rngween-hourly-wallet {
+  display: grid;
+  grid-template-columns: auto auto;
+  gap: 2px 7px;
+  margin-left: auto;
+  align-items: center;
+  color: var(--text);
+}
+.rngween-hourly-wallet svg {
+  color: #fb923c;
+  grid-row: span 2;
+}
+.rngween-hourly-wallet strong {
+  font: 600 16px var(--font-mono);
+}
+.rngween-hourly-wallet small {
+  color: var(--secondary);
+  font-size: 9px;
+}
+.rngween-hourly-rules {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  padding: 16px 0 19px;
+}
+.rngween-hourly-rules span {
+  display: inline-flex;
+  gap: 5px;
+  align-items: center;
+  padding: 5px 8px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  font-size: 9px;
+  color: var(--secondary);
+}
+.rngween-hourly-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+}
+.rngween-hourly-card {
+  min-width: 0;
+  padding: 16px;
+  border-radius: 11px;
+  border: 1px solid var(--border);
+  background: color-mix(in srgb, var(--bg) 58%, transparent);
+  display: flex;
+  flex-direction: column;
+}
+.rngween-hourly-card[data-source="world"] {
+  border-color: color-mix(in srgb, #5eead4 24%, var(--border));
+}
+.rngween-hourly-card-top {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  justify-content: space-between;
+  color: var(--secondary);
+  font-size: 9px;
+}
+.rngween-hourly-card-top > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+.rngween-hourly-card-top svg {
+  flex-shrink: 0;
+}
+.rngween-hourly-countdown {
+  font-family: var(--font-mono);
+  white-space: nowrap;
+}
+.rngween-hourly-card h3 {
+  font-size: 14px;
+  font-weight: 650;
+  margin: 16px 0 8px;
+}
+.rngween-hourly-card > p {
+  font-size: 11px;
+  color: var(--secondary);
+  line-height: 1.8;
+  margin: 0 0 17px;
+}
+.rngween-hourly-meter {
+  margin-top: auto;
+  font: 10px var(--font-mono);
+  color: var(--secondary);
+}
+.rngween-hourly-meter progress {
+  display: block;
+  width: 100%;
+  height: 4px;
+  margin: 9px 0 15px;
+  border: 0;
+  border-radius: 4px;
+  overflow: hidden;
+  background: var(--border);
+  accent-color: #a78bfa;
+}
+.rngween-hourly-meter progress::-webkit-progress-bar {
+  background: var(--border);
+}
+.rngween-hourly-meter progress::-webkit-progress-value {
+  background: #a78bfa;
+}
+.rngween-hourly-reward {
+  display: flex;
+  gap: 6px;
+  align-items: center;
+  color: var(--text);
+  font-size: 11px;
+  min-height: 29px;
+}
+.rngween-hourly-reward > svg {
+  color: #fb923c;
+}
+.rngween-hourly-world-link {
+  display: inline-grid;
+  place-items: center;
+  margin-left: auto;
+  width: 36px;
+  height: 32px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  color: var(--text);
+  background: var(--surface);
+  cursor: pointer;
+}
+.rngween-hourly-world-link:hover {
+  background: var(--hover);
+}
+.rngween-hourly-foot {
+  display: block;
+  margin-top: 17px;
+  padding-top: 14px;
+  border-top: 1px solid var(--border);
+  color: var(--secondary);
+  font-size: 10px;
+  line-height: 1.8;
+}
+.rngween-hourly-foot p {
+  margin: 0 0 6px;
+  display: flex;
+  gap: 5px;
+  align-items: center;
+}
+.rngween-hourly-foot small {
+  display: block;
+  font-size: 9px;
+  color: var(--muted);
+}
+.rngween-hourly-empty p {
+  color: var(--secondary);
+  font-size: 12px;
+  line-height: 1.8;
+}
+.rngween-hourly-empty button {
+  margin: 8px 0;
+}
+.rngween-hourly-card.is-loading {
+  min-height: 150px;
+  align-items: center;
+  justify-content: center;
+  color: var(--muted);
+}
+@media (max-width: 520px) {
+  .rngween-hourly-grid {
+    grid-template-columns: 1fr;
+  }
+  .rngween-hourly-head > div {
+    flex: 1 1 190px;
+  }
+  .rngween-hourly-wallet {
+    margin: 8px 0 0;
+  }
+}
diff --git a/src/rngween-hourly.js b/src/rngween-hourly.js
