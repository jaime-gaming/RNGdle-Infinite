+.rngween-decor {
+  position: fixed;
+  inset: 79px 0 0;
+  overflow: hidden;
+  pointer-events: none;
+  color: var(--rngween-purple);
+  z-index: -1;
+}
+.rngween-web {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: clamp(60px, 8vw, 110px);
+  opacity: 0.4;
+  stroke-width: 0.75;
+}
+.rngween-pumpkin {
+  position: absolute;
+  top: 76px;
+  left: 2%;
+  opacity: 0.5;
+  color: var(--rngween-orange);
+}
+.rngween-bat {
+  position: absolute;
+  top: 88px;
+  right: 5%;
+  opacity: 0.4;
+  transform: rotate(-14deg);
+  animation: rngween-drift 8s ease-in-out infinite alternate;
+}
+.rngween-ghost {
+  position: absolute;
+  top: 167px;
+  right: 1%;
+  opacity: 0.35;
+  animation: rngween-drift 6s ease-in-out infinite alternate-reverse;
+}
