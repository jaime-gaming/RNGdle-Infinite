diff --git a/src/rngween-world.worker.js b/src/rngween-world.worker.js
new file mode 100644
index 0000000..ec8717a
--- /dev/null
+++ b/src/rngween-world.worker.js
@@ -0,0 +1,19 @@
+import {
+  randomWorldNumber,
+  randomWorldMiniNumber,
+} from "./rngween-world-random.js";
+
+self.onmessage = ({ data }) => {
+  const { id, drawn, zone = "valley" } = data;
+  try {
+    self.postMessage({
+      id,
+      number:
+        zone === "valley"
+          ? randomWorldNumber(drawn)
+          : randomWorldMiniNumber(zone),
+    });
+  } catch (error) {
+    self.postMessage({ id, error: error.message });
+  }
+};
