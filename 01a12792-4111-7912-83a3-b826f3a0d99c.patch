+/* CLEANUP after Nov 3, 2026 ends (Nov 4 00:00 UTC): remove the seasonal
+   tokens/decorations. Keep mission/owned-collection CSS until their own cleanup.
+   Seasonal tokens are an overlay: removing data-season restores the player's
+   theme. Rarity palettes and game mechanics are deliberately untouched. */
+:root[data-season="rngween"] {
+  --rngween-orange: #a14616;
+  --rngween-purple: #7851a0;
+}
+/* Keep the negative decoration layer above the page canvas in every browser. */
+:root[data-season="rngween"] #root {
+  isolation: isolate;
+}
+:root[data-season="rngween"][data-theme="dark"] {
+  --bg: #17121e;
+  --surface: #211a2a;
+  --text: #f7eee5;
+  --muted: #b3a0b5;
+  --secondary: #c7b6cc;
+  --border: #3c2e42;
+  --hover: #302438;
+  --green: #ffb477;
+  --green-bg: #382619;
+  --button: #f7eee5;
+  --rngween-orange: #ffb477;
+  --rngween-purple: #c4a2ef;
+  --shadow: 0 4px 24px #0002;
+}
+
+/* Winning draw panels keep their semantic green, not the seasonal accent. */
+:root[data-season="rngween"] .draw-panel.is-winner {
+  --green: #2f6b57;
+}
+:root[data-season="rngween"][data-theme="dark"] .draw-panel.is-winner {
+  --green: #89c4a8;
+}
